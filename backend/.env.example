# Copiá este archivo a ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" con contraseñas reales a un repositorio público.

# --- Base de datos SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=DiveSafeProDB
DB_USER=divesafe_app
DB_PASSWORD=CAMBIAR_ESTA_CONTRASEÑA

# --- Servidor backend ---
PORT=4000

# --- Seguridad (JWT) ---
# Cualquier texto largo y random sirve. Es la "clave" con la que
# se firman las sesiones de los usuarios logueados.
JWT_SECRET=cambia-este-texto-por-algo-largo-y-random-12345
